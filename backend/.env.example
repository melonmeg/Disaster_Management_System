# Copy to backend/.env and fill in real values. Never commit backend/.env.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=emergency_response_management
# Database used by the automated tests (cloned from DB_NAME by scripts/create_test_db.py)
TEST_DB_NAME=emergency_response_management_test

# DBA account used ONLY by the setup scripts (scripts/*.py). The running API never uses it.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=change-me

# Least-privilege MySQL accounts used by the API, one per application role.
# scripts/setup_db.py creates these users with the passwords below.
DB_AUTH_USER=erm_auth
DB_AUTH_PASSWORD=change-me-auth
DB_ADMIN_USER=erm_admin
DB_ADMIN_PASSWORD=change-me-admin
DB_DISPATCHER_USER=erm_dispatcher
DB_DISPATCHER_PASSWORD=change-me-dispatcher
DB_RESPONDER_USER=erm_responder
DB_RESPONDER_PASSWORD=change-me-responder

# JWT signing secret: use a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Initial application users created by scripts/setup_db.py (passwords are bcrypt-hashed).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-Admin1
SEED_DISPATCHER_USERNAME=aarav
SEED_DISPATCHER_PASSWORD=change-me-Dispatch1
SEED_RESPONDER_USERNAME=diya
SEED_RESPONDER_PASSWORD=change-me-Respond1

# Allowed browser origins (Next.js dev server)
CORS_ORIGINS=http://localhost:3000

# --- Geocoding: Mappls (MapmyIndia). Get a static key in the Mappls console (https://about.mappls.com/api/). ---
MAPPLS_API_KEY=
# Country code; optional for India, required for other countries
MAPPLS_REGION=
# Several matches further apart than this are treated as AMBIGUOUS and not placed on the map
GEOCODER_AMBIGUITY_KM=5

# Largest call recording the API accepts, in MB (MySQL max_allowed_packet must be larger; default 64 MB)
MAX_RECORDING_MB=25

# --- MongoDB: recommendation_history, call_transcripts ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=erms

# --- Speech-to-text for call recordings: Groq Whisper (the audio is sent to Groq). Uses LLM_API_KEY if STT_API_KEY is empty. ---
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_ENABLED=true

# --- Operational log in MongoDB (data changes and failed requests); entries expire after this many days ---
OPLOG_ENABLED=true
OPLOG_RETENTION_DAYS=90

# --- Optional LLM explanations: any OpenAI-compatible chat-completions API (e.g. Llama API). ---
# Copy the base URL and model name from your provider's dashboard/docs. Leave empty to use the ranking only.
# The request goes to {LLM_BASE_URL}/chat/completions with "Authorization: Bearer LLM_API_KEY".
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_ENABLED=true

# --- Recommendation scoring weights (optional override) ---
# RECO_WEIGHTS=capability=0.5,availability=0.2,distance=0.2,resources=0.1
