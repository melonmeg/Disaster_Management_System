# Copy to backend/.env and fill in real values. Never commit backend/.env.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=emergency_response_management
# Database used by the automated tests (cloned from DB_NAME by scripts/create_test_db.py)
TEST_DB_NAME=emergency_response_management_test

# DBA account used ONLY by the setup scripts (scripts/*.py). The running API never uses it.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=change-me

# Least-privilege MySQL accounts used by the API, one per application role.
# scripts/setup_db.py creates these users with the passwords below.
DB_AUTH_USER=erm_auth
DB_AUTH_PASSWORD=change-me-auth
DB_ADMIN_USER=erm_admin
DB_ADMIN_PASSWORD=change-me-admin
DB_DISPATCHER_USER=erm_dispatcher
DB_DISPATCHER_PASSWORD=change-me-dispatcher
DB_RESPONDER_USER=erm_responder
DB_RESPONDER_PASSWORD=change-me-responder

# JWT signing secret: use a long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

# Initial application users created by scripts/setup_db.py (passwords are bcrypt-hashed).
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-Admin1
SEED_DISPATCHER_USERNAME=aarav
SEED_DISPATCHER_PASSWORD=change-me-Dispatch1
SEED_RESPONDER_USERNAME=diya
SEED_RESPONDER_PASSWORD=change-me-Respond1

# Allowed browser origins (Next.js dev server)
CORS_ORIGINS=http://localhost:3000
